          "supportLevel": "independent"
        },
        {
          "id": "q004",
          "type": "numeric",
          "prompt": "72 × 11 = ?",
          "answer": 792,
          "difficulty": 2,
          "hints": ["Add the two outside digits (7 + 2)."],
          "supportLevel": "independent"
        }
      ]
    },
    {
      "type": "recall",
      "questions": [
        {
          "id": "q005",
          "type": "ordering",
          "prompt": "Without looking at any clues, put the ×11 trick steps in the correct order!",
          "options": [
            { "id": "a", "label": "Keep the first digit on the left" },
            { "id": "b", "label": "Add the two digits together" },
            { "id": "c", "label": "Place the sum in the middle" },
            { "id": "d", "label": "Keep the last digit on the right" }
          ],
          "answer": ["a", "b", "c", "d"],
          "difficulty": 3,
          "hints": [],
          "supportLevel": "independent"
        },
        {
          "id": "q006",
